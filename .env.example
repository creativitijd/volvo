# ── Website (Vercel) ─────────────────────────────────────────
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Geheim voor /api/revalidate (zelf te kiezen, lange willekeurige string)
REVALIDATE_SECRET=
# Sevalla object storage (advertentiefoto's). S3_PUBLIC_URL na "Public access".
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# ── Scraper + meldingen (GitHub Actions secrets) ─────────────
SUPABASE_URL=https://xxxx.supabase.co
# Schrijfsleutel: NOOIT in Vercel of in de browser zetten
SUPABASE_SERVICE_ROLE_KEY=
# Resend (resend.com > API Keys) en een afzender op je geverifieerde domein
RESEND_API_KEY=
ALERT_FROM=Vind een Volvo <meldingen@jouwdomein.be>
SITE_URL=https://jouwdomein.be
# Krijgt een mail bij nieuwe particuliere advertenties om na te kijken
ADMIN_EMAIL=
